# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# --- Octopus (required) ---
OCTOPUS_TOKEN=
ACCOUNT_NUMBER=

# --- Mastodon (required) ---
MASTO_TOKEN=
BOT_HOME=https://mastodon.social
SEND_TOOT_TO=@recipient@host.com

# Must be "yes" for toots to actually send. Leave as "no" for a dry run.
SEND_TOOTS=no

# --- Solar forecast (required for collector.py) ---
LAT=
LNG=
DEC=
AZ=
KWP=
